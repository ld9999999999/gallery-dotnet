<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Gallery.Desktop.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <SolidColorBrush x:Key="GalleryBackground">#15171c</SolidColorBrush>
    <SolidColorBrush x:Key="GalleryPanel">#1d2027</SolidColorBrush>
    <SolidColorBrush x:Key="GalleryCell">#262a33</SolidColorBrush>
    <SolidColorBrush x:Key="GalleryBorder">#2a2f3a</SolidColorBrush>
    <SolidColorBrush x:Key="GalleryMuted">#8b93a7</SolidColorBrush>
    <SolidColorBrush x:Key="GalleryAccent">#4f8cff</SolidColorBrush>
    <SolidColorBrush x:Key="GalleryDanger">#ff5f6d</SolidColorBrush>
    <!-- Line icons on a 24×24 grid (see Views/Icon.cs) -->
    <StreamGeometry x:Key="IconClose">M6,6 L18,18 M18,6 L6,18</StreamGeometry>
    <StreamGeometry x:Key="IconInfo">M3,12 A9,9 0 1 1 21,12 A9,9 0 1 1 3,12 M12,11 L12,17 M12,7.5 L12,7.6</StreamGeometry>
    <StreamGeometry x:Key="IconRotateRight">M18.1,9.5 A7,7 0 1 1 10.8,6.1 M8.6,3.4 L11.4,6 L8.8,8.9</StreamGeometry>
    <StreamGeometry x:Key="IconRotateLeft">M5.9,9.5 A7,7 0 1 0 13.2,6.1 M15.4,3.4 L12.6,6 L15.2,8.9</StreamGeometry>
    <StreamGeometry x:Key="IconFolder">M3,6.5 L9.5,6.5 L11.5,8.5 L21,8.5 L21,18.5 L3,18.5 Z</StreamGeometry>
    <StreamGeometry x:Key="IconOpen">M14,4 L20,4 L20,10 M20,4 L11,13 M18,14 L18,20 L4,20 L4,6 L10,6</StreamGeometry>
    <StreamGeometry x:Key="IconPlay">M8,5 L19,12 L8,19 Z</StreamGeometry>
    <StreamGeometry x:Key="IconNote">M10,17.5 A3,2.5 0 1 1 4,17.5 A3,2.5 0 1 1 10,17.5 M10,17.5 L10,4 L19,6.5 L19,9.5 L10,7</StreamGeometry>
    <StreamGeometry x:Key="IconFaces">M4,8 L4,4 L8,4 M16,4 L20,4 L20,8 M20,16 L20,20 L16,20 M8,20 L4,20 L4,16 M9,10 A3,3 0 1 1 15,10 A3,3 0 1 1 9,10 M7,17.5 C8.5,14.5 15.5,14.5 17,17.5</StreamGeometry>
    <StreamGeometry x:Key="IconEdit">M4,20 L4.6,16.4 L15.6,5.4 L18.6,8.4 L7.6,19.4 Z M13.6,7.4 L16.6,10.4</StreamGeometry>
    <StreamGeometry x:Key="IconSmall">M7,7 L17,7 L17,17 L7,17 Z</StreamGeometry>
    <StreamGeometry x:Key="IconLarge">M3,3 L21,3 L21,21 L3,21 Z</StreamGeometry>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Gallery.Desktop/Styles.axaml" />
  </Application.Styles>
</Application>
