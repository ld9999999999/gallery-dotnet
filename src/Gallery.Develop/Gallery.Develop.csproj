<Project Sdk="Microsoft.NET.Sdk">

  <!-- The photo editor's adjustments and editing format, with no dependencies: compiled to WebAssembly for the
       browser editor, and used natively by the server for exports (see docs/raw-editor.md). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Gallery.Tests" />
    <InternalsVisibleTo Include="Gallery.Core" />
  </ItemGroup>

</Project>
