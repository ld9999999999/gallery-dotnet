<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Gallery.Desktop.ViewModels"
             xmlns:v="using:Gallery.Desktop.Views"
             x:Class="Gallery.Desktop.Views.YearsView"
             x:DataType="vm:YearsViewModel">
  <Grid ColumnDefinitions="200,*">
    <DockPanel Background="{StaticResource GalleryPanel}">
      <TextBlock DockPanel.Dock="Top" Classes="help" Margin="12,10" IsVisible="{Binding IsEmpty}" Text="No dated photos yet." />
      <ListBox x:Name="YearList" ItemsSource="{Binding Years}" SelectedItem="{Binding Selected}" Background="Transparent" Margin="0,6,0,0">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:YearEntry">
            <DockPanel>
              <TextBlock DockPanel.Dock="Right" Classes="muted" FontSize="12" VerticalAlignment="Center" Text="{Binding Count, StringFormat='{}{0:N0}'}" />
              <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding Year}" />
            </DockPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>
    <DockPanel Grid.Column="1">
      <StackPanel DockPanel.Dock="Top" Margin="16,10,16,0" IsVisible="{Binding Selected, Converter={x:Static ObjectConverters.IsNotNull}}">
        <TextBlock Classes="title" Text="{Binding Selected.Year}" />
        <TextBlock Classes="muted" FontSize="12" Text="{Binding Selected.Detail}" />
      </StackPanel>
      <v:PhotoGridView DataContext="{Binding Grid}" />
    </DockPanel>
  </Grid>
</UserControl>
