<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Gallery.Desktop.ViewModels"
        xmlns:v="using:Gallery.Desktop.Views"
        x:Class="Gallery.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Gallery"
        Width="1280" Height="820" MinWidth="640" MinHeight="420"
        Background="{StaticResource GalleryBackground}">
  <DockPanel>
    <!-- Status bar: what the library is doing, and its totals -->
    <Border DockPanel.Dock="Bottom" Background="{StaticResource GalleryPanel}" BorderBrush="{StaticResource GalleryBorder}"
            BorderThickness="0,1,0,0" Padding="12,5">
      <DockPanel>
        <TextBlock DockPanel.Dock="Right" Classes="muted" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0"
                   Text="{Binding LibraryText}" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Width="60" MinWidth="60" Height="4" VerticalAlignment="Center" />
          <TextBlock x:Name="Status" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding StatusText}" />
        </StackPanel>
      </DockPanel>
    </Border>

    <Panel>
      <TabControl x:Name="Tabs" SelectedIndex="{Binding SelectedTab}">
        <TabItem Header="All photos">
          <v:AllPhotosView DataContext="{Binding AllPhotos}" />
        </TabItem>
        <TabItem Header="Albums">
          <v:AlbumsView DataContext="{Binding Albums}" />
        </TabItem>
        <TabItem Header="Years">
          <v:YearsView DataContext="{Binding Years}" />
        </TabItem>
        <TabItem Header="People">
          <v:PeopleView DataContext="{Binding People}" />
        </TabItem>
        <TabItem Header="Settings">
          <v:SettingsView DataContext="{Binding SettingsPage}" />
        </TabItem>
      </TabControl>

      <!-- Thumbnail size, level with the tabs -->
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,16,0" Spacing="6"
                  ToolTip.Tip="Thumbnail size">
        <v:Icon Data="{StaticResource IconSmall}" Width="14" Height="14" Foreground="{StaticResource GalleryMuted}" VerticalAlignment="Center" />
        <Slider x:Name="ThumbSlider" Width="140" Minimum="90" Maximum="420" SmallChange="10" LargeChange="40" VerticalAlignment="Center"
                Value="{Binding ThumbSize}" />
        <v:Icon Data="{StaticResource IconLarge}" Width="18" Height="18" Foreground="{StaticResource GalleryMuted}" VerticalAlignment="Center" />
      </StackPanel>

      <Panel IsVisible="{Binding Viewer, Converter={x:Static ObjectConverters.IsNotNull}}">
        <v:ViewerView DataContext="{Binding Viewer}" />
      </Panel>

      <Panel IsVisible="{Binding Editor, Converter={x:Static ObjectConverters.IsNotNull}}">
        <v:EditorView DataContext="{Binding Editor}" />
      </Panel>
    </Panel>
  </DockPanel>
</Window>
